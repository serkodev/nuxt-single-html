{
  "name": "nuxt-single-html",
  "version": "0.0.1",
  "description": "Build a Nuxt app into a single HTML file.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serkodev/nuxt-single-html.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "play": "nuxi dev playground",
    "play:build": "nuxi build playground",
    "play:generate": "nuxi generate playground",
    "play:preview": "nuxi preview playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm lint && pnpm prepack && changelogen --no-output --release && pnpm publish && git push --follow-tags",
    "release:minor": "pnpm lint && pnpm prepack && changelogen --no-output --release --minor && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^3.15.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "2.0.0-beta.3",
    "@nuxt/eslint-config": "^0.7.5",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.15.4",
    "@nuxt/test-utils": "^3.15.4",
    "@types/node": "^22.12.0",
    "changelogen": "^0.5.7",
    "eslint": "^9.19.0",
    "nuxt": "^3.15.4",
    "typescript": "~5.6.3",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@9.15.4"
}
